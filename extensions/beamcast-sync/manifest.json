{
  "manifest_version": 3,
  "name": "BeamCast Sync",
  "version": "0.4.3",
  "description": "Delays video frames to match BeamCast AirPlay latency (audio stays live).",
  "permissions": ["alarms", "tabs", "storage"],
  "host_permissions": ["http://localhost:46382/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "BeamCast Sync"
  }
}
